<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.casasmart.hub-mdns</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__REPO_ROOT__/deploy/macos/mdns_publish.py</string>
    <string>--refresh</string><string>30</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/casasmart-hub-mdns.log</string>
  <key>StandardErrorPath</key><string>/tmp/casasmart-hub-mdns.log</string>
</dict>
</plist>
